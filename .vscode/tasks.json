{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/API/EventConnect.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: build tests",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/API/EventConnect.Tests", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--solution", "EventConnect.slnx"],
      "options": { "cwd": "${workspaceFolder}/API" },
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: watch",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "${workspaceFolder}/API/EventConnectAPI"],
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: database update",
      "type": "shell",
      "command": "dotnet tool restore && dotnet ef database update --project EventConnectCore --startup-project EventConnectAPI",
      "options": { "cwd": "${workspaceFolder}/API" },
      "problemMatcher": []
    },
    {
      "label": "ui: install",
      "type": "npm",
      "script": "install",
      "path": "UI",
      "problemMatcher": []
    },
    {
      "label": "ui: ensure dependencies",
      "type": "process",
      "command": "node",
      "args": [
        "-e",
        "const fs = require('fs'); if (fs.existsSync('node_modules/.bin/vite')) { console.log('UI dependencies already installed.'); } else { console.log('UI dependencies missing, running npm install...'); require('child_process').execSync('npm install', { stdio: 'inherit' }); }"
      ],
      "options": { "cwd": "${workspaceFolder}/UI" },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "ui: dev",
      "type": "npm",
      "script": "dev",
      "path": "UI",
      "dependsOn": "ui: ensure dependencies",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activeBegin": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http"
        }
      }
    },
    {
      "label": "ui: build",
      "type": "npm",
      "script": "build",
      "path": "UI",
      "dependsOn": "ui: ensure dependencies",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "ui: lint",
      "type": "npm",
      "script": "lint",
      "path": "UI",
      "dependsOn": "ui: ensure dependencies",
      "problemMatcher": []
    },
    {
      "label": "ui: test",
      "type": "npm",
      "script": "test",
      "path": "UI",
      "dependsOn": "ui: ensure dependencies",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test: all",
      "dependsOn": ["api: test", "ui: test"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "ui: stop dev server",
      "type": "shell",
      "command": "${input:terminateUiDev}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateUiDev",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "ui: dev"
    }
  ]
}
