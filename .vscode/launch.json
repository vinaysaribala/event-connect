{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: Debug (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "api: build",
      "program": "${workspaceFolder}/API/EventConnectAPI/bin/Debug/net10.0/EventConnectAPI.dll",
      "cwd": "${workspaceFolder}/API/EventConnectAPI",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5207"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/openapi/v1.json"
      }
    },
    {
      "name": "UI: Debug (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "ui: dev",
      "postDebugTask": "ui: stop dev server",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/UI"
    },
    {
      "name": "UI: Debug (Edge)",
      "type": "msedge",
      "request": "launch",
      "preLaunchTask": "ui: dev",
      "postDebugTask": "ui: stop dev server",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/UI"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + UI (Chrome)",
      "configurations": ["API: Debug (.NET)", "UI: Debug (Chrome)"],
      "stopAll": true
    }
  ]
}
